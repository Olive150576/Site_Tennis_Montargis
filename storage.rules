rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Règles pour le dossier images/
    match /images/{imageId} {
      // Lecture publique
      allow read: if true;

      // Écriture : utilisateurs authentifiés + validation
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Suppression : admins uniquement (via custom claim)
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Règles pour le dossier documents/
    match /documents/{docId} {
      // Lecture publique
      allow read: if true;

      // Écriture : utilisateurs authentifiés + validation PDF
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';

      // Suppression : admins uniquement (via custom claim)
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
