rules_version = '2';

// Cloud Firestore Security Rules
// Ce projet utilise Realtime Database, pas Firestore
// Ces règles bloquent tout accès pour sécuriser Firestore

service cloud.firestore {
  match /databases/{database}/documents {
    // Bloquer tout accès - Firestore n'est pas utilisé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
