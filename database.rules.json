{
  "rules": {
    "news": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["createdAt", "date"]
    },
    "event": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "inst": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "coach": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "rates": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "sponsors": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "info": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "documents": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "contacts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": true,
      "$contactId": {
        ".validate": "newData.hasChildren(['name', 'email', 'message', 'date', 'timestamp']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length < 200 && newData.child('email').isString() && newData.child('email').val().length > 5 && newData.child('email').val().length < 200 && newData.child('message').isString() && newData.child('message').val().length > 0 && newData.child('message').val().length < 5000 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() >= (now - 300000) && newData.child('timestamp').val() <= (now + 10000)"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
        "prenom":     { ".read": true },
        "nom":        { ".read": true },
        "actif":      { ".read": true },
        "classement": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^(-15|-4[/]6|-2[/]6|0|1[/]6|2[/]6|3[/]6|4[/]6|5[/]6|15|15[/]1|15[/]2|15[/]3|15[/]4|15[/]5|30|30[/]1|30[/]2|30[/]3|30[/]4|30[/]5|40|NC)$/))"
        },
        "categorie":  { ".read": true },
        "licence":    { ".read": true },
        "email": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length < 150 && (newData.val() === '' || newData.val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/))"
        },
        "telephone": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length < 20 && (newData.val() === '' || newData.val().matches(/^[0-9+ .()-]{6,20}$/))"
        },
        "classementHistory": {
          ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid === $uid",
          "$entryId": {
            ".validate": "newData.hasChildren(['from', 'to', 'at']) && newData.child('at').isNumber()"
          }
        },
        "photoURL": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length < 2000"
        },
        "partenaire": {
          ".read": "auth != null && root.child('members').child(auth.uid).child('actif').val() === true",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['public_profile', 'updatedAt'])"
        }
      }
    },
    "scans": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false,
      "$uid": {
        ".write": true,
        "$scanId": {
          ".validate": "newData.hasChildren(['t']) && newData.child('t').isNumber() && newData.child('t').val() >= (now - 60000) && newData.child('t').val() <= (now + 10000)"
        }
      }
    },
    "tournaments": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "push_subscriptions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false,
      "$tokenId": {
        ".write": "!data.exists() || data.child('token').val() === newData.child('token').val()",
        ".validate": "newData.hasChildren(['token', 'subscribedAt']) && newData.child('token').isString() && newData.child('token').val().length > 50 && newData.child('token').val().length < 500 && newData.child('subscribedAt').isString() && newData.child('subscribedAt').val().length < 30 && !newData.hasChild('script') && !newData.hasChild('html')"
      }
    },
    "club_messages": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["createdAt", "actif"]
    },
    "partenaire_index": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "!newData.exists() || newData.hasChildren(['prenom', 'nom'])"
      }
    },
    "qr_scans": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "accueil": {
        "total": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "par_jour": {
          ".read": true,
          ".write": true,
          "$day": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && $day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          }
        }
      }
    },
    "championnats_equipe": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "inscriptions_equipe": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$champId": {
        "$uid": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $uid && (!newData.exists() || !data.exists() || data.child('statut').val() !== 'refuse')))",
          "valide": {
            ".validate": "newData.val() === false || root.child('admins').child(auth.uid).exists()"
          },
          "statut": {
            ".validate": "root.child('admins').child(auth.uid).exists() || !newData.exists()"
          },
          "motifRefus": {
            ".validate": "root.child('admins').child(auth.uid).exists() || !newData.exists()"
          },
          "refusedAt": {
            ".validate": "root.child('admins').child(auth.uid).exists() || !newData.exists()"
          },
          "validatedAt": {
            ".validate": "root.child('admins').child(auth.uid).exists() || !newData.exists()"
          }
        }
      }
    },
    "equipes": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('members').child(auth.uid).child('actif').val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["champId"],
      "$equipeId": {
        "joueurs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !newData.exists()"
          }
        },
        "convocations": {
          "$rencontreId": {
            "reponses": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('actif').val() === true",
                ".validate": "newData.hasChildren(['statut', 'at']) && (newData.child('statut').val() === 'confirme' || newData.child('statut').val() === 'decline') && newData.child('at').isNumber()"
              }
            }
          }
        }
      }
    },
    "notifications_equipe": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["uid", "lue", "champId"],
      "$notifId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        "lue": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid"
        }
      }
    },
    "push_subscriptions_membres": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "$tokenHash": {
          ".validate": "newData.hasChildren(['token', 'keys', 'subscribedAt']) && newData.child('token').isString() && newData.child('token').val().length > 50 && newData.child('token').val().length < 500 && newData.child('subscribedAt').isNumber()"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
