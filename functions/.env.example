# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs réelles.
# GMAIL_USER : l'adresse Gmail utilisée pour envoyer les emails du formulaire de contact.
# GMAIL_APP_PASSWORD : mot de passe d'application généré sur https://myaccount.google.com/apppasswords
#   (nécessite la validation en 2 étapes activée sur le compte Gmail).
GMAIL_USER=
GMAIL_APP_PASSWORD=
