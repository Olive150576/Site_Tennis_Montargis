@@ -0,0 +1,214 @@
+/* =====================================================================
+   Nouveau site (site_v2) et boutique du club — fonctions Cloud
+   ---------------------------------------------------------------------
+   À copier dans le dossier functions/ du dépôt du site
+   (github.com/Olive150576/Site_Tennis_Montargis), puis brancher dans
+   functions/index.js (voir brancher-site-v2.patch) :
+
+     const siteV2 = require('./site-v2')({ functions, admin, getMailTransporterSafe, escapeHtml });
+     exports.onSiteV2Message = siteV2.onSiteV2Message;
+     exports.onBoutiqueReservation = siteV2.onBoutiqueReservation;
+     exports.onBoutiqueAvis = siteV2.onBoutiqueAvis;
+
+   Réutilise l'envoi Gmail déjà en place (GMAIL_USER / GMAIL_APP_PASSWORD).
+   Sans configuration Gmail : rien n'est envoyé, rien ne casse (message dans les logs).
+
+   • onSiteV2Message       : formulaire du nouveau site (contact, essai, partenariat)
+                             → e-mail au bureau (même adresse que le site actuel : info/email).
+   • onBoutiqueReservation : réservation boutique créée → e-mail de confirmation au membre.
+   • onBoutiqueAvis        : message du bureau lié à une commande (boutons de l'admin
+                             « Passer en Commandée », « Disponible au club », « Annuler »)
+                             → e-mail au membre, avec le détail de ses réservations.
+   • mirrorNewsToSiteV2    : recopie dans site_v2/news une actu créée par le webhook
+                             Metricool/Make (createNewsWebhook), pour qu'elle apparaisse
+                             aussi sur le nouveau site.
+   ===================================================================== */
+'use strict';
+
+const SITE = 'https://tennismontargis.fr';
+const BOUTIQUE_URL = SITE + '/espace-membre.html#boutique';
+const TZ = 'Europe/Paris';
+
+module.exports = function siteV2({ functions, admin, getMailTransporterSafe, escapeHtml }) {
+  const db = () => admin.database();
+  const val = async (path) => (await db().ref(path).once('value')).val();
+  const esc = (s) => escapeHtml(s == null ? '' : s);
+
+  /* ---------- Mise en forme ---------- */
+  const euro = (n) => {
+    n = Math.round((Number(n) || 0) * 100) / 100;
+    return (n % 1 ? n.toFixed(2).replace('.', ',') : String(n)) + ' €';
+  };
+  const dateLong = (t) => new Date(t).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: TZ });
+  const deadlineEnd = (p) => p.deadlineTs || (p.deadline ? new Date(p.deadline + 'T23:59:59').getTime() : 0);
+  const sizeKey = (s) => String(s == null ? '' : s).replace(/[.#$/[\]]/g, '_');
+  const detail = (r) => [r.size, r.color, '× ' + r.qty].filter(Boolean).join(' · ') + (r.marking ? ' · marquage « ' + r.marking + ' »' : '');
+  const noun = (p, n) => {
+    let w = String(p.name || 'pièce').split(/\s+/)[0].toLowerCase();
+    if (p.minMode === 'size') w = 'pièce';
+    return n > 1 && !/[sx]$/.test(w) ? w + 's' : w;
+  };
+  /* Même calcul que l'espace membre : pièces réservées et pièces manquantes */
+  function progress(p, c) {
+    c = c || {};
+    const min = Math.max(1, +p.minQty || 1), total = c.total || 0;
+    if (p.minMode === 'size') {
+      let missing = 0, any = false;
+      (p.sizes || []).forEach((s) => { const n = (c.parTaille || {})[sizeKey(s)] || 0; if (n) { any = true; missing += Math.max(0, min - n); } });
+      if (!any) missing = min;
+      return { total, min, missing, reached: any && missing === 0, bySize: true };
+    }
+    return { total, min, missing: Math.max(0, min - total), reached: total >= min, bySize: false };
+  }
+
+  /* Gabarit aux couleurs du nouveau site : bleu royal, jaune balle, tableau de score vert */
+  function emailHtml({ heading, kicker, bodyHtml, ctaLabel, ctaUrl, footer }) {
+    const cta = ctaLabel ? `<tr><td style="padding:6px 0 4px;"><a href="${esc(ctaUrl || BOUTIQUE_URL)}" style="display:inline-block;background:#dcf23f;color:#0b1640;text-decoration:none;font-weight:bold;padding:13px 26px;border-radius:999px;font-size:15px;">${esc(ctaLabel)}</a></td></tr>` : '';
+    return `<!DOCTYPE html><html lang="fr"><body style="margin:0;padding:0;background:#f3f5fa;">
+<table width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5fa;padding:24px 12px;"><tr><td align="center">
+<table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #d9dfec;border-radius:16px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
+<tr><td style="background:#1541c9;padding:20px 24px;">
+  <div style="color:#ffffff;font-weight:bold;font-size:17px;letter-spacing:1px;">USM TENNIS MONTARGIS</div>
+  <div style="color:#dcf23f;font-size:12px;margin-top:3px;letter-spacing:.5px;">${esc(kicker || 'Espace membre')}</div>
+</td></tr>
+<tr><td style="padding:26px 24px 8px;"><table width="100%" cellpadding="0" cellspacing="0">
+  <tr><td style="color:#0b1640;font-size:20px;font-weight:bold;padding-bottom:14px;">${esc(heading)}</td></tr>
+  <tr><td style="color:#47527a;font-size:15px;line-height:1.6;padding-bottom:18px;">${bodyHtml}</td></tr>
+  ${cta}
+</table></td></tr>
+<tr><td style="padding:18px 24px 22px;color:#6f7897;font-size:12px;line-height:1.5;border-top:1px solid #e9edf6;">${footer || 'USM Tennis Montargis · 43 avenue Louis Maurice Chautemps, 45200 Montargis'}</td></tr>
+</table></td></tr></table></body></html>`;
+  }
+  const box = (html) => `<div style="margin:6px 0 14px;padding:14px 16px;background:#f7f8fc;border:1px solid #e9edf6;border-radius:12px;color:#0b1640;">${html}</div>`;
+  const board = (pr) => `<div style="margin:6px 0 14px;padding:14px 16px;background:#0f3d2f;border-radius:12px;color:#f2efe0;">
+    <span style="font-size:28px;font-weight:bold;color:#dcf23f;">${pr.total}</span><span style="font-size:16px;font-weight:bold;"> / ${pr.min}${pr.bySize ? ' par taille' : ''}</span>
+    <span style="font-size:13px;color:#cfd9cc;"> pièces réservées</span><br>
+    <span style="font-size:15px;">${pr.reached ? '<b style="color:#4ade80;">Objectif atteint</b>' : 'Il en manque <b style="color:#dcf23f;">' + pr.missing + '</b>'}</span></div>`;
+  const rule = (p) => `<p style="margin:0 0 12px;padding:12px 14px;background:#eef6f1;border:1px solid #cfe5d8;border-radius:10px;color:#24533c;font-size:14px;"><b>Règle d'or :</b> personne ne paie tant que le minimum n'est pas atteint. S'il ne l'est pas le ${esc(dateLong(deadlineEnd(p)))}, la commande est annulée et vous êtes prévenu(e).</p>`;
+
+  async function send(to, subject, html, text, replyTo) {
+    if (!to) return false;
+    const transporter = getMailTransporterSafe();
+    if (!transporter) return false; // configuration Gmail absente : déjà signalé dans les logs
+    const gmailUser = (functions.config().gmail && functions.config().gmail.user) || process.env.GMAIL_USER;
+    try {
+      await transporter.sendMail({ from: `"USM Tennis Montargis" <${gmailUser}>`, to, subject, text, html, replyTo: replyTo || undefined });
+      return true;
+    } catch (err) {
+      console.error('[site_v2] Échec envoi à', to, ':', err.message);
+      return false;
+    }
+  }
+  async function clubEmail() {
+    return (await val('info/email')) || (await val('site_v2/settings/email')) || null;
+  }
+
+  /* ---------- 1. Formulaires du nouveau site → bureau ---------- */
+  const SUBJ = { renseignement: 'Renseignement', essai: 'Séance d\'essai', inscription: 'Inscription', cours: 'Cours / stage', partenariat: 'Partenariat', autre: 'Autre' };
+  async function handleSiteMessage(m) {
+    if (!m || !m.email || !m.name) return { sent: false, why: 'incomplet' };
+    const to = (await clubEmail()) || ((functions.config().gmail && functions.config().gmail.user) || process.env.GMAIL_USER);
+    const isPartner = m.type === 'partenariat' || m.subject === 'partenariat';
+    const extra = Object.assign({}, m.extra || {});
+    ['name', 'email', 'phone', 'subject', 'message', 'consent'].forEach((k) => delete extra[k]);
+    const company = extra.company || extra.entreprise || '';
+    const subject = isPartner ? `Demande de partenariat — ${company || m.name}` : `Nouveau message${m.subject ? ' (' + (SUBJ[m.subject] || m.subject) + ')' : ''} — ${m.name}`;
+    const rows = [['Nom', m.name], ['E-mail', m.email], ['Téléphone', m.phone], ['Sujet', SUBJ[m.subject] || m.subject]]
+      .concat(Object.keys(extra).filter((k) => extra[k] && String(extra[k]).length < 300).map((k) => [k.charAt(0).toUpperCase() + k.slice(1), extra[k]]))
+      .filter((r) => r[1]);
+    const body = rows.map((r) => `<b>${esc(r[0])} :</b> ${esc(r[1])}`).join('<br>') +
+      `<br><br><b>Message :</b>${box(esc(m.message || '').replace(/\n/g, '<br>'))}Répondez directement à cet e-mail pour écrire à ${esc(m.name)}.`;
+    const text = rows.map((r) => r[0] + ' : ' + r[1]).join('\n') + '\n\n' + (m.message || '');
+    const sent = await send(to, subject, emailHtml({ heading: subject, kicker: 'Formulaire du site', bodyHtml: body, ctaLabel: 'Ouvrir les messages dans l\'admin', ctaUrl: SITE + '/admin/#/messages', footer: 'Message envoyé depuis le formulaire de tennismontargis.fr. Il est aussi enregistré dans Admin › Messages.' }), text, m.email);
+    return { sent, to, subject };
+  }
+
+  /* ---------- 2. Réservation boutique → confirmation au membre ---------- */
+  async function handleReservation(pid, uid, r) {
+    if (!r || r.status === 'annulee') return { sent: false, why: 'annulée' };
+    const [p, member, counter] = await Promise.all([val('site_v2/shopProducts/' + pid), val('members/' + uid), val('boutique_compteurs/' + pid)]);
+    if (!p) return { sent: false, why: 'produit introuvable' };
+    if (!member || !member.email) { console.log('[boutique] pas d\'e-mail pour', uid); return { sent: false, why: 'pas d\'e-mail' }; }
+    const pr = progress(p, counter);
+    const end = dateLong(deadlineEnd(p));
+    const prenom = member.prenom ? esc(member.prenom) : '';
+    const subject = `C'est réservé : ${p.name}`;
+    const body = (prenom ? `Bonjour ${prenom},<br><br>` : '') + 'Votre réservation est bien enregistrée :' +
+      box(`<b>${esc(p.name)}</b><br>${esc(detail(r))}<br>Total : <b>${euro(r.total)}</b>, à régler seulement si la commande part.`) +
+      '<b>Où en est la commande ?</b>' + board(pr) + rule(p) +
+      (pr.reached ? '' : `<b>Envie d'accélérer ?</b> Partagez le lien à vos partenaires de jeu : il manque encore ${pr.missing} ${esc(noun(p, pr.missing))}.<br><br>`) +
+      `Vous pouvez modifier ou annuler jusqu'au ${esc(end)} inclus, depuis la Boutique de votre espace membre.`;
+    const text = `Bonjour ${member.prenom || ''},\n\nVotre réservation est enregistrée : ${p.name} — ${detail(r)} — total ${euro(r.total)}, à régler seulement si la commande part.\n` +
+      `Commande : ${pr.total} / ${pr.min} pièces${pr.reached ? ', objectif atteint' : ', il en manque ' + pr.missing}.\nPersonne ne paie tant que le minimum n'est pas atteint. Modifiable jusqu'au ${end} : ${BOUTIQUE_URL}`;
+    const sent = await send(member.email, subject, emailHtml({ heading: 'C\'est réservé !', kicker: 'Boutique du club · commande groupée', bodyHtml: body, ctaLabel: 'Voir ma réservation', ctaUrl: BOUTIQUE_URL }), text, await clubEmail());
+    return { sent, to: member.email, subject };
+  }
+
+  /* ---------- 3. Messages du bureau (Commandée / Disponible / Annulée) → membre ---------- */
+  async function handleAvis(uid, n) {
+    if (!n || !n.pid) return { sent: false, why: 'sans produit' };
+    const [p, member, mine] = await Promise.all([val('site_v2/shopProducts/' + n.pid), val('members/' + uid), val('boutique_reservations/' + n.pid + '/' + uid)]);
+    if (!member || !member.email) return { sent: false, why: 'pas d\'e-mail' };
+    const list = Object.keys(mine || {}).map((k) => mine[k]).filter((r) => r && r.status !== 'annulee');
+    const name = (p && p.name) || 'votre commande';
+    const lines = list.map((r) => `${esc(detail(r))} — ${euro(r.total)}${r.paid ? ' (réglé)' : ''}`).join('<br>');
+    const due = list.filter((r) => !r.paid).reduce((s, r) => s + (r.total || 0), 0);
+    const prenom = member.prenom ? `Bonjour ${esc(member.prenom)},<br><br>` : '';
+    let subject, heading, body, cta = 'Ouvrir la boutique';
+    if (n.kind === 'commandee') {
+      subject = `Objectif atteint : la commande ${name} est lancée`;
+      heading = 'La commande part !';
+      body = prenom + 'Bonne nouvelle : le minimum est atteint et le club vient de passer la commande au fournisseur.' +
+        box(`<b>${esc(name)}</b><br>${lines}${due ? `<br>À régler : <b>${euro(due)}</b>` : '<br><b>Déjà réglé, merci !</b>'}`) +
+        (due ? (p && p.payUrl ? `<b>Pour régler :</b> en ligne en 2 minutes depuis la Boutique de votre espace membre, ou au club auprès d'un membre du bureau.<br><br>` : `<b>Pour régler :</b> au club, auprès d'un membre du bureau, avant la livraison.<br><br>`) : '') +
+        'Les réservations sont maintenant verrouillées ; pour tout changement, répondez simplement à cet e-mail.' +
+        (p && p.deliveryDate ? `<br><br><b>Livraison estimée :</b> ${esc(dateLong(new Date(p.deliveryDate + 'T12:00:00').getTime()))}. On vous prévient dès que c'est arrivé.` : '');
+      if (due && p && p.payUrl) cta = 'Régler ma commande';
+    } else if (n.kind === 'disponible') {
+      subject = `Votre ${name} vous attend au club`;
+      heading = 'Votre commande est arrivée !';
+      body = prenom + box(`<b>${esc(name)}</b><br>${lines}`) +
+        'Elle vous attend au club house, 43 avenue Louis Maurice Chautemps à Montargis. Montrez votre carte de membre (QR code dans votre espace) à la personne du bureau présente.' +
+        (due ? `<br><br>Pas encore réglé ? Prévoyez <b>${euro(due)}</b> pour régler sur place${p && p.payUrl ? ', ou réglez en ligne avant de passer' : ''}.` : '') +
+        '<br><br>Vous ne pouvez pas venir ? Répondez à cet e-mail : un coéquipier peut la récupérer pour vous.';
+      cta = 'Voir ma commande';
+    } else if (n.kind === 'annulee') {
+      subject = `Commande ${name} annulée : rien à payer`;
+      heading = 'Commande annulée';
+      body = prenom + esc(n.text || '').replace(/\n/g, '<br>') + (lines ? box(`<b>Votre réservation annulée</b><br>${lines}`) : '') + 'Vous n\'avez rien à payer.';
+    } else {
+      subject = n.title || 'Message du club';
+      heading = n.title || 'Message du club';
+      body = prenom + esc(n.text || '').replace(/\n/g, '<br>');
+    }
+    const text = (member.prenom ? `Bonjour ${member.prenom},\n\n` : '') + (n.text || heading) + (list.length ? '\n\n' + list.map((r) => detail(r) + ' — ' + euro(r.total)).join('\n') : '') + '\n\n' + BOUTIQUE_URL;
+    const sent = await send(member.email, subject, emailHtml({ heading, kicker: 'Boutique du club · commande groupée', bodyHtml: body, ctaLabel: cta, ctaUrl: BOUTIQUE_URL }), text, await clubEmail());
+    return { sent, to: member.email, subject };
+  }
+
+  /* ---------- 4. Actus automatiques (Metricool / Make) → nouveau site ---------- */
+  const slugify = (s) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase().slice(0, 70);
+  async function mirrorNewsToSiteV2({ title, text, imageUrl }) {
+    // Avant l'import du contenu du nouveau site, on n'écrit rien (sinon cette actu masquerait les autres)
+    if (!(await db().ref('site_v2/news').once('value')).exists()) return { written: false, why: 'site_v2 pas encore importé' };
+    const id = 'n' + Date.now().toString(36);
+    const clean = String(text || '').trim();
+    const title2 = String(title || clean.slice(0, 60)).replace(/\.\.\.$/, '…');
+    const excerpt = clean.length <= 170 ? clean : clean.slice(0, 170).replace(/\s+\S*$/, '') + '…';
+    const today = new Date().toLocaleDateString('fr-CA', { timeZone: TZ }); // AAAA-MM-JJ
+    const item = { id, title: title2, date: today, category: 'vie-du-club', body: clean, excerpt, images: imageUrl ? [{ src: imageUrl, sm: imageUrl, alt: title2 }] : [],
+      featured: false, draft: false, slug: slugify(title2) + '-' + id.slice(-4), createdAt: Date.now(), source: 'facebook' };
+    await db().ref().update({ ['site_v2/news/' + id]: item, 'site_v2/updatedAt': new Date().toISOString() });
+    return { written: true, id };
+  }
+
+  /* ---------- Déclencheurs ---------- */
+  const log = (tag) => (r) => { console.log(`[${tag}]`, JSON.stringify(r)); return null; };
+  return {
+    onSiteV2Message: functions.database.ref('/site_v2_messages/{id}').onCreate((snap) => handleSiteMessage(snap.val()).then(log('onSiteV2Message'))),
+    onBoutiqueReservation: functions.database.ref('/boutique_reservations/{pid}/{uid}/{rid}').onCreate((snap, ctx) => handleReservation(ctx.params.pid, ctx.params.uid, snap.val()).then(log('onBoutiqueReservation'))),
+    onBoutiqueAvis: functions.database.ref('/boutique_avis/{uid}/{id}').onCreate((snap, ctx) => handleAvis(ctx.params.uid, snap.val()).then(log('onBoutiqueAvis'))),
+    mirrorNewsToSiteV2,
+    _test: { handleSiteMessage, handleReservation, handleAvis, progress }
+  };
+};
