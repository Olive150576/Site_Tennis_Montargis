{
  "_comment": "Détail des règles du nouveau site, DÉJÀ INCLUSES dans firebase/database.rules.json (fichier complet prêt à déployer).",
  "rules": {
    "site_v2": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "site_v2_messages": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['id', 'name', 'email', 'createdAt']) && newData.child('message').isString() && newData.child('message').val().length < 5000"
      }
    }
  }
}